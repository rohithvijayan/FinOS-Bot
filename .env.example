# FinOS Bot — Environment Variables
# Copy this file to .env and fill in real values

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your Telegram User ID (get it by messaging @userinfobot)
ALLOWED_CHAT_ID=your-telegram-user-id-here

# Supabase (same project as FinOS web)
SUPABASE_URL=https://aitfcvnehspwtwedmoja.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Feature Flags
ENABLE_COPILOT=true

